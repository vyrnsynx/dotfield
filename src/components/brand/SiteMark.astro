---
interface Props {
  label?: string;
}

const { label = "Site mark" } = Astro.props;
---

<!-- Official jckhlry mark asset (clean favicon path). Avoid the 13px Framer path — it rings/aliases badly. -->
<img
  class="site-mark"
  src="/favicon-light.svg"
  width="13"
  height="13"
  alt={label}
  decoding="async"
/>

<style>
  .site-mark {
    display: block;
    flex: none;
    width: 13px;
    height: 13px;
  }
</style>