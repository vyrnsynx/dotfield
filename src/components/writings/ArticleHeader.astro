---
import {
  writingCategoryPath,
  writingTagPath,
} from "../../data/writings";
import type { WritingTaxonomyReference } from "../../lib/writings";

interface Props {
  title: string;
  categorySlug: string;
  categoryLabel: string;
  pubDate: Date;
  updatedDate?: Date;
  description: string;
  author: string;
  tags: readonly WritingTaxonomyReference[];
  readingMinutes: number;
}

const {
  title,
  categorySlug,
  categoryLabel,
  pubDate,
  updatedDate,
  description,
  author,
  tags,
  readingMinutes,
} = Astro.props;
const dateLabel = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
const updatedDateLabel = updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<header class="article-header">
  <p class="article-header__crumb">
    <a href={writingCategoryPath(categorySlug)}>{categoryLabel}</a>
    <span aria-hidden="true">·</span>
    <time datetime={pubDate.toISOString()}>{dateLabel}</time>
    <span aria-hidden="true">·</span>
    <span>{readingMinutes} min read</span>
  </p>
  <h1>{title}</h1>
  <p class="article-header__desc">{description}</p>
  <div class="article-header__byline">
    <span>By {author}</span>
    {
      updatedDate && updatedDateLabel ? (
        <span>
          Updated{" "}
          <time datetime={updatedDate.toISOString()}>{updatedDateLabel}</time>
        </span>
      ) : null
    }
  </div>
  {
    tags.length > 0 ? (
      <ul class="article-header__tags" aria-label="Article tags">
        {tags.map((tag) => (
          <li>
            <a href={writingTagPath(tag.slug)}>#{tag.label}</a>
          </li>
        ))}
      </ul>
    ) : null
  }
</header>

<style>
  .article-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-header__crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    color: var(--color-label-muted);
    font-family: var(--font-sans);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-body);
  }

  .article-header__crumb a {
    color: inherit;
    text-decoration: none;
  }

  .article-header__crumb a:hover,
  .article-header__crumb a:focus-visible {
    color: var(--color-ink-strong);
  }

  .article-header__crumb a:focus-visible,
  .article-header__tags a:focus-visible {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .article-header h1 {
    color: var(--color-ink-strong);
    font-family: var(--font-sans);
    font-size: var(--font-size-article-title);
    font-weight: var(--font-weight-medium);
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .article-header__desc {
    max-width: 40rem;
    color: var(--color-ink-soft);
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-body);
  }

  .article-header__byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    color: var(--color-label-muted);
    font-size: var(--font-size-caption);
    line-height: 1.4;
  }

  .article-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-header__tags a {
    display: inline-flex;
    min-height: 1.5rem;
    align-items: center;
    padding: 2px 5px;
    background: var(--color-surface-soft);
    color: var(--color-ink);
    font-size: var(--font-size-caption);
    text-decoration: none;
  }

  .article-header__tags a:hover {
    background: var(--color-accent);
    color: var(--color-ink-strong);
  }
</style>