<dialog
  class="lightbox"
  data-article-lightbox
  aria-label="Enlarged image"
>
  <div class="lightbox__bar" data-lightbox-keep>
    <p class="lightbox__count" data-lightbox-count></p>
    <form method="dialog">
      <button class="lightbox__close" type="submit">Close</button>
    </form>
  </div>
  <button
    class="lightbox__nav lightbox__nav--prev"
    type="button"
    data-lightbox-prev
    data-lightbox-keep
    aria-label="Previous image"
  >
    Prev
  </button>
  <figure class="lightbox__figure" data-lightbox-keep>
    <img alt="" data-lightbox-image draggable="false" />
    <figcaption data-lightbox-caption hidden></figcaption>
  </figure>
  <button
    class="lightbox__nav lightbox__nav--next"
    type="button"
    data-lightbox-next
    data-lightbox-keep
    aria-label="Next image"
  >
    Next
  </button>
</dialog>

<script>
  import "../../scripts/article-lightbox";
</script>

